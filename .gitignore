# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MediaMTX (Semáforo) -- binário baixado manualmente e certificado
# autogerado (só usado pelo servidor MoQ, desligado em mediamtx.yml,
# mas ainda gerado por versões antigas do binário), nenhum dos dois
# versionado. Config em mediamtx/mediamtx.yml continua committada.
mediamtx/mediamtx.exe
mediamtx/auto.crt
mediamtx/auto.key
